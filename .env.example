# Copier en apps/api/.env pour le développement.

# Sans DATABASE_URL, Écolage utilise PGlite (Postgres embarqué) dans apps/api/.data.
# DATABASE_URL=postgres://user:password@localhost:5432/ecolage

# Obligatoire en production (32 caractères minimum) : openssl rand -hex 32
# JWT_SECRET=

# URL publique de l'application (portail parents, retour de paiement).
APP_URL=http://localhost:5173

# Paiement : « mock » (simulation) ou « fedapay ».
# Avec FEDAPAY_SECRET_KEY renseignée, FedaPay est choisi automatiquement.
# PAYMENT_PROVIDER=fedapay
# FEDAPAY_ENV=sandbox
# FEDAPAY_SECRET_KEY=sk_sandbox_...
# FEDAPAY_WEBHOOK_SECRET=wh_sandbox_...

# Bouton « Essayer avec une école d'exemple » : une école par visiteur, effacée après 24 h.
DEMO_MODE=true
